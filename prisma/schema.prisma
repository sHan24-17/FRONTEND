generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id            Int       @id @default(autoincrement())
  codigo        String    @unique @db.VarChar(20)
  nombre        String    @db.VarChar(150)
  descripcion   String?
  categoria     String    @db.VarChar(50)
  precio        Decimal   @db.Decimal(10, 2)
  stock         Int
  estado        Boolean?  @default(true)
  urlImagen     String?   @map("url-imagen") @db.VarChar(500)
  fechaCreacion DateTime? @default(now()) @map("fecha_creacion") @db.Timestamp(6)

  @@index([codigo], map: "idx_productos_codigo")
  @@index([categoria], map: "idx_productos_categoria")
  @@map("productos")
}

model Usuario {
  id            Int       @id @default(autoincrement())
  nombre        String    @db.VarChar(150)
  email         String    @unique @db.VarChar(100)
  rol           String?   @default("usuario") @db.VarChar(50)
  activo        Boolean?  @default(true)
  fechaCreacion DateTime? @default(now()) @map("fecha-creacion") @db.Timestamp(6)

  @@map("usuarios")
}
